# bgts-context-engine settings for the MCP server your editor starts (`bce serve-mcp`).
# Written by `bce cursor-init` / `bce claude-init` with working defaults; edit the values, then
# reload the editor window. Usually only the API key (or the URL of your own model server) in
# section 2 needs filling in. This file holds keys: keep it out of version control.

# --- 1. Database with the index (defaults match deploy/docker-compose.yml) --------------------
BCE_DB_HOST=localhost
BCE_DB_PORT=5432
BCE_DB_NAME=bce
BCE_DB_USER=bce
BCE_DB_PASSWORD=bce

# --- 2. Embedding model: must be the one the index was built with -----------------------------
# Model and dimension are stored with the vectors. With a different model here the server skips
# the semantic anchor and says why in coverage.semantic_error.
#
# a) Voyage AI (hosted, default): paste the key.
BCE_EMBEDDING_PROVIDER=voyage
BCE_EMBEDDING_MODEL=voyage-code-4
BCE_EMBEDDING_DIM=1024
BCE_VOYAGE_API_KEY=
#
# b) Open model on your own server (vLLM, TEI, Ollama: any OpenAI-compatible /v1/embeddings).
#    Comment out block a) and uncomment these; leave the API key empty for a server without auth.
# BCE_EMBEDDING_PROVIDER=openai
# BCE_EMBEDDING_MODEL=jina-code-embeddings-1.5b
# BCE_EMBEDDING_DIM=1536
# BCE_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# BCE_EMBEDDING_API_KEY=
#
# c) No model (offline; lexical and graph signals only, index built the same way):
# BCE_EMBEDDING_PROVIDER=hashing

# --- 3. Context selector (optional): cuts the answer down to the files the task edits ---------
# off | jev (TypeSafe's Jev over OpenRouter, needs OPENROUTER_API_KEY)
#     | decider-4b / decider-2b (open weights on your GPU, needs BCE_SELECTOR_URL)
BCE_SELECTOR=off
# OPENROUTER_API_KEY=
# BCE_SELECTOR_URL=http://<host>:<port>/v1/systemone

# --- 4. MCP surface ----------------------------------------------------------------------------
# Tools the server advertises (empty = all read tools). One tool costs the agent fewest turns.
BCE_MCP_TOOLS=get_context_for_task
