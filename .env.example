# Copy to .env and fill in. All variables are optional; defaults match deploy/docker-compose.yml.
# Read by bce.config.Settings (prefix BCE_). .env is gitignored.

# --- PostgreSQL (single DB: AGE + pgvector + SQL) ---
BCE_DB_HOST=localhost
BCE_DB_PORT=5432
BCE_DB_NAME=bce
BCE_DB_USER=bce
BCE_DB_PASSWORD=bce
# Name of the Apache AGE graph holding the code graph.
BCE_GRAPH_NAME=code_graph

# --- i18n (presentation only; never affects payload) ---
BCE_DEFAULT_LOCALE=en
# Locales the API and UI accept, as a JSON array. Anything else falls back to the default.
BCE_SUPPORTED_LOCALES=["en","tr"]

# --- CORS ---
# Browser origins allowed to call the API, as a JSON array. The bundled UI is served from the
# API's own origin and needs no entry here; this only matters for a separately hosted frontend
# such as the Vite dev server. Use ["*"] for development only.
BCE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Embedding (Phase 2; anchor finding only, pinned for determinism P2) ---
# Provider: "hashing" (default, dependency-free deterministic fallback) or "voyage" (Voyage AI).
BCE_EMBEDDING_PROVIDER=hashing
BCE_EMBEDDING_MODEL=voyage-code-3
BCE_EMBEDDING_DIM=1024
# Required when BCE_EMBEDDING_PROVIDER=voyage:
BCE_VOYAGE_API_KEY=

# --- Bitbucket Cloud remote indexing (bce index-remote / POST /v1/index-remote) ---
# Access token (recommended): leave username empty; we clone as x-token-auth:<token>.
# App password: also set BCE_BITBUCKET_USERNAME to your Bitbucket username.
BCE_BITBUCKET_USERNAME=
BCE_BITBUCKET_TOKEN=
# Where cloned repos are cached (re-index does a fast git fetch). Gitignored.
BCE_REPO_CACHE_DIR=.bce_data/repos
# Set to false ONLY behind a TLS-intercepting corporate proxy.
BCE_GIT_SSL_VERIFY=true

# --- Logging (JSON lines to stdout; optional rotating file sink) ---
# DEBUG logs request start, body, response and every pipeline stage; INFO logs summaries only.
BCE_LOG_LEVEL=INFO
# Set to true to ALSO write logs to a rotating file (path below).
BCE_LOG_FILE_ENABLED=false
BCE_LOG_FILE_PATH=.bce_data/logs/bce.log
BCE_LOG_FILE_MAX_BYTES=10485760
BCE_LOG_FILE_BACKUP_COUNT=5

# --- Background jobs (async indexing via POST /v1/jobs/*) ---
# Worker threads running inside the API server process (1 = jobs run strictly in order).
BCE_JOB_WORKERS=1
# Seconds a worker sleeps between queue polls when idle.
BCE_JOB_POLL_INTERVAL=2.0
